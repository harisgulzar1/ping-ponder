OPENAI_API_KEY=your_api_key

# Optional. Realtime model for the Ping speech agent. The server mints the
# ephemeral key for this model and reports it to the client, so both sides stay
# in agreement. Default: gpt-realtime-2.1
# REALTIME_MODEL=gpt-realtime-2.1

# Optional. Model used by the Ponder reasoning agent. Default: gpt-4.1
# PONDER_MODEL=gpt-4.1
